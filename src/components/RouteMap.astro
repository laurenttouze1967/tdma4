---
import { WIDTH, HEIGHT, VIEW_H, sphere, graticule, land, borderPath, legs, points, regionViews, regionOf } from '../lib/map';
import { formatDate, dayOfTrip, urls, articleBySlug } from '../lib/data';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const PAD = 8;
const fmtRange = (a: string, b?: string) => {
  if (!b || b <= a) return formatDate(a);
  const [ya, ma] = [a.slice(0, 4), a.slice(5, 7)];
  const da = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', ...(ma !== b.slice(5, 7) || ya !== b.slice(0, 4) ? { month: 'long' } : {}), ...(ya !== b.slice(0, 4) ? { year: 'numeric' } : {}), timeZone: 'UTC' }).format(new Date(a + 'T00:00:00Z'));
  return `du ${da} au ${formatDate(b)}`;
};
const data = points.map((p) => ({
  name: p.name, country: p.country, date: fmtRange(p.date, p.until), approx: p.dateApprox, day: dayOfTrip(p.date), transit: !!p.transit,
  mode: p.mode, note: p.note, x: p.x, y: p.y, region: p.transit || p.country === 'France' ? 'monde' : regionOf(p.country),
  article: p.article ? { url: urls.article(p.article), title: articleBySlug(p.article).title } : null,
}));
// étiquettes des vues régionales : un nom par lieu, sans chevauchement
const labelsFor = (v: (typeof regionViews)[number]) => {
  const placed: { x: number; y: number }[] = [];
  const seen = new Set<string>();
  const out: { x: number; y: number; name: string; i: number; anchor: string }[] = [];
  v.points.forEach((pt, i) => {
    const st = points[i];
    if (!pt.inside || st.transit || seen.has(st.name) || st.name === 'Colombes') return;
    if (placed.some((q) => Math.abs(q.x - pt.x) < 70 && Math.abs(q.y - pt.y) < 15)) return;
    seen.add(st.name); placed.push(pt);
    const anchor = pt.x > WIDTH - 140 ? 'end' : 'start';
    out.push({ x: pt.x + (anchor === 'end' ? -8 : 8), y: pt.y + 4, name: st.name.replace(/ \(.*\)$/, ''), i, anchor });
  });
  return out;
};
const modeLabel = { avion: 'en avion', bateau: 'en bateau', route: 'par la route', bus: 'en bus', train: 'en train' } as const;
---
<div class:list={['routemap', { compact }]} data-routemap>
  {!compact && (
    <div class="views-tabs" role="toolbar" aria-label="Zoom sur un continent">
      <button type="button" data-view-btn="monde" aria-pressed="true">Monde</button>
      {regionViews.map((v) => <button type="button" data-view-btn={v.key} aria-pressed="false">{v.label}</button>)}
    </div>
  )}
  <div class="map-scroll">
    <svg class="view world" data-view="monde" viewBox={`${-PAD} ${-PAD} ${WIDTH + 2 * PAD} ${HEIGHT + 2 * PAD}`} role="img"
         aria-label="Carte du monde en projection Equal Earth montrant l'itinéraire du tour du monde, de Colombes à Colombes en passant par plus de 150 étapes.">
      <defs>
        <clipPath id="sphere-clip"><path d={sphere} /></clipPath>
      </defs>
      <path class="sea" d={sphere} />
      <g clip-path="url(#sphere-clip)">
        <path class="grat" d={graticule} />
        {land.map((c: any) => <path class:list={['land', { visited: c.visited }]} d={c.d} />)}
        <path class="borders" d={borderPath} />
        <g class="legs">
          {legs.map((l) => <path class={`leg ${l.mode}`} d={l.d} data-i={l.index} />)}
        </g>
      </g>
      <path class="outline" d={sphere} />
      <g class="stops">
        {points.map((p, i) => (
          <g class:list={['stop', { home: i === 0 || i === points.length - 1, transit: p.transit }]} data-i={i} transform={`translate(${p.x} ${p.y})`}
             tabindex={compact ? undefined : 0} role={compact ? undefined : 'button'} aria-label={compact ? undefined : `${p.name}, ${data[i].date}`}>
            <circle class="hit" r="11" />
            <circle class="dot" r={i === 0 ? 5.5 : p.transit ? 2 : 3.2} />
          </g>
        ))}
      </g>
    </svg>
    {!compact && regionViews.map((v) => (
      <svg class="view region" data-view={v.key} viewBox={`0 0 ${WIDTH} ${VIEW_H}`} role="img" hidden
           aria-label={`Carte détaillée : ${v.label}, avec les étapes du voyage.`}>
        <rect class="sea" width={WIDTH} height={VIEW_H} />
        <path class="grat" d={v.graticule} />
        {v.land.map((c: any) => <path class:list={['land', { visited: c.visited }]} d={c.d} />)}
        <path class="borders" d={v.borders} />
        <g class="legs">
          {v.legs.map((l) => <path class={`leg ${l.mode}`} d={l.d} data-i={l.index} />)}
        </g>
        <g class="labels" aria-hidden="true">
          {labelsFor(v).map((l) => <text class="lbl" data-i={l.i} x={l.x} y={l.y} text-anchor={l.anchor}>{l.name}</text>)}
        </g>
        <g class="stops">
          {v.points.map((pt, i) => pt.inside && (
            <g class:list={['stop', { home: i === 0 || i === points.length - 1, transit: points[i].transit }]} data-i={i} transform={`translate(${pt.x} ${pt.y})`}
               tabindex="0" role="button" aria-label={`${points[i].name}, ${data[i].date}`}>
              <circle class="hit" r="11" />
              <circle class="dot" r={points[i].transit ? 2.5 : 4.2} />
            </g>
          ))}
        </g>
      </svg>
    ))}
  </div>

  {!compact && (
    <div class="panel" aria-live="polite">
      <div class="controls">
        <button type="button" class="btn play" data-play aria-label="Lancer l'animation">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-play" d="M8 5v14l11-7z" /><path class="i-pause" d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
          <span>Rejouer le voyage</span>
        </button>
        <button type="button" class="btn ghost icon" data-prev aria-label="Étape précédente">‹</button>
        <button type="button" class="btn ghost icon" data-next aria-label="Étape suivante">›</button>
        <div class="progress" aria-hidden="true"><span data-bar></span></div>
        <span class="day" data-day>Jour 1 / 317</span>
      </div>
      <div class="info" data-info>
        <p class="eyebrow" data-step>Étape 1 / {data.length}</p>
        <h3 data-name>{data[0].name}</h3>
        <p class="when" data-when>{data[0].date}</p>
        <p class="note" data-note>{data[0].note}</p>
        <a data-link href={data[0].article?.url ?? '#'}>Lire le récit<span data-link-title></span> →</a>
      </div>
      <ul class="legend" aria-label="Légende">
        <li><i class="l avion"></i>avion</li>
        <li><i class="l route"></i>route, bus ou train</li>
        <li><i class="l escale"></i>escale</li>
        <li><i class="l bateau"></i>bateau</li>
      </ul>
    </div>
  )}
  <script type="application/json" data-stops set:html={JSON.stringify({ data, modeLabel })} />
</div>

<style>
  .routemap { --leg: var(--terracotta); }
  .map-scroll { border-radius: var(--radius); overflow-x: auto; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; background: var(--sea); scrollbar-width: thin; }
  .routemap:not(.compact) .map-scroll svg.world { min-width: 760px; }
  .view[hidden] { display: none; }
  .map-scroll svg { width: 100%; }
  .sea { fill: #dfe8ec; }
  .outline { fill: none; stroke: #b9c8cf; stroke-width: 1; }
  .grat { fill: none; stroke: #fff; stroke-width: .5; opacity: .7; }
  .land { fill: #ece2cc; }
  .land.visited { fill: var(--terracotta-soft); }
  .borders { fill: none; stroke: #fff; stroke-width: .5; stroke-linejoin: round; }
  .leg { fill: none; stroke: var(--bordeaux); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .leg.avion { stroke-dasharray: 5 4; stroke-width: 1.4; }
  .leg.bateau { stroke: #1f6f8b; stroke-dasharray: 1 3.5; stroke-width: 2.2; }
  .stop .hit { fill: transparent; }
  .lbl { font: 600 12.5px/1 var(--sans); fill: #3a2c24; paint-order: stroke; stroke: rgb(255 255 255 / .85); stroke-width: 3px; stroke-linejoin: round; pointer-events: none; }
  .lbl.future { opacity: 0; }
  .region .leg { stroke-width: 2.2; }
  .region .leg.avion { stroke-width: 1.6; }
  .views-tabs { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .7rem; }
  .views-tabs button { font: 600 .88rem/1 var(--sans); padding: .55rem .9rem; border-radius: 999px; border: 0; cursor: pointer;
    background: var(--card); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--line); transition: background .2s, color .2s; }
  .views-tabs button:hover { box-shadow: inset 0 0 0 1.5px var(--terracotta); }
  .views-tabs button[aria-pressed='true'] { background: var(--bordeaux); color: #fff; box-shadow: none; }
  .stop .dot { fill: #fff; stroke: var(--bordeaux); stroke-width: 1.5; transition: r .25s, fill .25s; }
  .stop.home .dot { fill: var(--bordeaux); stroke: #fff; }
  .routemap:not(.compact) .stop { cursor: pointer; outline: none; }
  .stop:hover .dot, .stop:focus-visible .dot { fill: var(--terracotta); }
  .stop.transit .dot { fill: #fff; stroke: #9a8a80; stroke-width: 1.2; }
  .stop.current .dot { fill: var(--terracotta); stroke: var(--bordeaux); r: 7; }
  .stop.future { opacity: 0; }
  .leg.future { opacity: 0; }
  .compact .stop .dot { r: 3; }

  .panel { display: grid; gap: 1rem 2rem; margin-top: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .panel { grid-template-columns: 1fr 1fr; align-items: start; } .legend { grid-column: 1; } .info { grid-row: span 2; } }
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .6rem; }
  .btn.icon { width: 2.6rem; height: 2.6rem; padding: 0; justify-content: center; font-size: 1.4rem; line-height: 1; }
  .btn svg { width: 1.1rem; height: 1.1rem; fill: currentColor; }
  .i-pause { display: none; }
  .playing .i-pause { display: inline; } .playing .i-play { display: none; }
  .progress { flex: 1 1 8rem; height: 6px; border-radius: 3px; background: var(--line); overflow: hidden; min-width: 6rem; }
  .progress span { display: block; height: 100%; width: 0; background: var(--terracotta); transition: width .4s ease; }
  .day { font-size: .85rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; min-width: 7.5rem; }
  .info { background: var(--card); border-radius: var(--radius); padding: 1.1rem 1.3rem; box-shadow: 0 0 0 1px var(--line); min-height: 11rem; }
  .info h3 { margin: 0 0 .2rem; font-size: 1.6rem; }
  .info .when { margin: 0 0 .6rem; color: var(--ink-soft); font-size: .92rem; }
  .info .note { margin: 0 0 .8rem; }
  .info a { font-weight: 600; }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; margin: 0; padding: 0; font-size: .85rem; color: var(--ink-soft); }
  .legend .l { display: inline-block; width: 2rem; height: 0; border-top: 2px solid var(--bordeaux); vertical-align: middle; margin-right: .4rem; }
  .legend .l.avion { border-top-style: dashed; }
  .legend .l.bateau { border-top: 3px dotted #1f6f8b; }
  .legend .l.escale { width: .55rem; height: .55rem; border: 1.2px solid #9a8a80; border-radius: 50%; }
</style>

<script>
  type StopData = { name: string; country: string; date: string; approx: boolean; day: number; mode: string | null; transit: boolean;
    note: string; x: number; y: number; region: string; article: { url: string; title: string } | null };

  document.querySelectorAll<HTMLElement>('[data-routemap]').forEach((root) => {
    if (root.classList.contains('compact')) return;
    const { data, modeLabel } = JSON.parse(root.querySelector('[data-stops]')!.textContent!) as
      { data: StopData[]; modeLabel: Record<string, string> };
    const views = [...root.querySelectorAll<SVGSVGElement>('svg.view')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-view-btn]')];
    const allLegs = [...root.querySelectorAll<SVGPathElement>('.leg')];
    const allStops = [...root.querySelectorAll<SVGGElement>('.stop')];
    const allLabels = [...root.querySelectorAll<SVGTextElement>('.lbl')];
    const scroller = root.querySelector<HTMLElement>('.map-scroll')!;
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const playBtn = $('[data-play]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lastDay = data[data.length - 1].day;
    let current = data.length - 1;
    let playing = false;
    let token = 0;
    let follow = true;          // la carte suit le voyage d'un continent à l'autre
    let view = 'monde';

    const idx = (el: Element) => Number((el as HTMLElement).dataset.i);
    const visible = () => views.find((v) => v.dataset.view === view)!;

    function setView(key: string) {
      if (key === view) return;
      view = key;
      views.forEach((v) => v.toggleAttribute("hidden", v.dataset.view !== key));
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.viewBtn === key)));
    }
    tabs.forEach((t) => t.addEventListener('click', () => { follow = false; setView(t.dataset.viewBtn!); scrollTo(data[current]); }));

    function render(i: number, drawnUpTo = i) {
      current = i;
      allLegs.forEach((l) => {
        const k = idx(l);
        l.classList.toggle('future', k > drawnUpTo);
        if (k <= drawnUpTo) l.style.removeProperty('stroke-dasharray');
      });
      allStops.forEach((s) => { const k = idx(s); s.classList.toggle('future', k > drawnUpTo); s.classList.toggle('current', k === i); });
      allLabels.forEach((t) => t.classList.toggle('future', idx(t) > drawnUpTo));
      const d = data[i];
      if (follow) setView(d.region);
      $('[data-step]').textContent = `Étape ${i + 1} / ${data.length}${d.mode ? ' · ' + modeLabel[d.mode] : ''}${d.transit ? ' · escale' : ''}`;
      $('[data-name]').textContent = d.name + (d.country && d.name !== d.country ? ` — ${d.country}` : '');
      $('[data-when]').textContent = `${d.approx ? 'vers le ' : ''}${d.date} · jour ${d.day}`;
      $('[data-note]').textContent = d.note;
      $('[data-note]').hidden = !d.note;
      const link = $('[data-link]') as HTMLAnchorElement;
      if (d.article) { link.hidden = false; link.href = d.article.url; $('[data-link-title]').textContent = ` « ${d.article.title} »`; }
      else link.hidden = true;
      $('[data-bar]').style.width = `${(d.day / lastDay) * 100}%`;
      $('[data-day]').textContent = `Jour ${d.day} / ${lastDay}`;
      scrollTo(d);
    }

    // sur petit écran, la carte du monde défile pour garder l'étape au centre
    function scrollTo(d: StopData) {
      if (view !== 'monde' || scroller.scrollWidth <= scroller.clientWidth) return;
      const svg = visible();
      const vb = svg.viewBox.baseVal;
      const scale = svg.getBoundingClientRect().width / vb.width;
      scroller.scrollTo({ left: (d.x - vb.x) * scale - scroller.clientWidth / 2, behavior: reduce ? 'auto' : 'smooth' });
    }

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    async function drawLeg(k: number, my: number) {
      root.querySelectorAll<SVGPathElement>(`.leg[data-i="${k}"]`).forEach((l) => l.classList.remove('future'));
      const leg = visible().querySelector<SVGPathElement>(`.leg[data-i="${k}"]`);
      if (!leg) return;
      const len = leg.getTotalLength() || 1;
      if (len < 2) return;
      // on trace le tronçon progressivement, puis on remet son style (pointillés pour l'avion)
      leg.style.strokeDasharray = `${len} ${len}`;
      const dur = Math.min(1100, Math.max(220, len * (view === 'monde' ? 3 : 1.6)));
      const anim = leg.animate([{ strokeDashoffset: len }, { strokeDashoffset: 0 }], { duration: dur, easing: 'ease-in-out' });
      await anim.finished.catch(() => {});
      if (my !== token) return;
      leg.style.removeProperty('stroke-dasharray');
    }

    async function play(from = 0) {
      const my = ++token;
      follow = true;
      playing = true; root.classList.add('playing'); playBtn.querySelector('span')!.textContent = 'Pause';
      if (from === 0) render(0, 0);
      for (let i = from; i < data.length; i++) {
        if (i > 0) {
          // changement de continent : le long trajet se suit sur la carte du monde
          if (data[i].region !== data[i - 1].region || data[i].region === 'monde') setView(data[i].region === view && view !== 'monde' ? view : 'monde');
          root.querySelectorAll(`.stop[data-i="${i}"], .lbl[data-i="${i}"]`).forEach((e) => e.classList.remove('future'));
          await drawLeg(i, my);
        }
        if (my !== token) return;
        render(i);
        await wait(i === 0 ? 800 : data[i].transit ? 60 : 320);
        if (my !== token) return;
      }
      stop('Rejouer le voyage');
    }

    function stop(label = 'Reprendre') {
      token++; playing = false; root.classList.remove('playing');
      playBtn.querySelector('span')!.textContent = label;
    }

    const step = (to: number) => { stop(); follow = true; render(Math.max(0, Math.min(data.length - 1, to)), data.length); };
    playBtn.addEventListener('click', () => {
      if (playing) return stop();
      play(current >= data.length - 1 ? 0 : current + 1);
    });
    $('[data-prev]').addEventListener('click', () => step(current - 1));
    $('[data-next]').addEventListener('click', () => step(current + 1));
    allStops.forEach((s) => {
      const go = () => { stop(); follow = false; render(idx(s), data.length); };
      s.addEventListener('click', go);
      s.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
    });
    root.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('input,textarea,button')) return;
      if (e.key === 'ArrowRight') step(current + 1);
      if (e.key === 'ArrowLeft') step(current - 1);
    });

    follow = false;
    render(data.length - 1);
    // L'animation démarre d'elle-même la première fois que la carte apparaît à l'écran
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); play(0); }
      }, { threshold: 0.35 });
      io.observe(scroller);
    }
  });
</script>
