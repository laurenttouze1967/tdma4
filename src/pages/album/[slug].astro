---
import Base from '../../layouts/Base.astro';
import Film from '../../components/Film.astro';
import { rubriques, articlesOf, albumGroups, urls, formatDate, formatShort, type Rubrique } from '../../lib/data';

export function getStaticPaths() {
  const list = rubriques.filter((r) => r.photoCount > 0);
  return list.map((r, i) => ({ params: { slug: r.slug }, props: { r, prev: list[i - 1], next: list[i + 1] } }));
}
interface Props { r: Rubrique; prev?: Rubrique; next?: Rubrique }
const { r, prev, next } = Astro.props;
const groups = albumGroups(r.slug);
const films = articlesOf(r.slug).flatMap((a) => a.body.filter((p) => p.type === 'film').map((p) => (p as { file: string }).file));
const period = (from?: string | null, to?: string | null) => {
  if (!from) return '';
  const a = from.slice(0, 10), b = (to ?? from).slice(0, 10);
  return a === b ? formatDate(a) : `${formatShort(a)} – ${formatDate(b)}`;
};
---
<Base title={`Album : ${r.name}`} description={`${r.photoCount} photos de notre passage en ${r.name} pendant notre tour du monde.`} image={r.cover?.src}>
  <div class="container head">
    <nav class="crumbs" aria-label="Fil d'Ariane"><ol><li><a href="/">Accueil</a></li><li><a href="/album/">Album photos</a></li><li aria-current="page">{r.name}</li></ol></nav>
    <p class="eyebrow">Album photos · {r.photoCount} photos{films.length > 0 && ` · ${films.length} film${films.length > 1 ? 's' : ''}`}</p>
    <h1>{r.name}</h1>
    {groups.length > 1 && (
      <nav class="toc" aria-label="Lieux">
        {groups.map((g, i) => <a href={`#g${i}`}>{g.title}</a>)}
        {films.length > 0 && <a href="#films">Films</a>}
      </nav>
    )}
  </div>

  <div class="container pswp-gallery">
    {groups.map((g, gi) => (
      <section class="set" id={`g${gi}`}>
        <h2>
          {g.title}
          <small>{g.from ? `${period(g.from, g.to)} · ` : ''}{g.photos.length} photo{g.photos.length > 1 ? 's' : ''}</small>
          {g.link && <a class="more" href={g.link.href}>{g.link.label} →</a>}
        </h2>
        <div class="justified">
          {g.photos.map((p, i) => (
            <a class="ph" href={p.full ?? p.src} data-pswp-width={p.fw ?? p.w} data-pswp-height={p.fh ?? p.h}
               data-cap={`${g.title}${p.date ? ' · ' + formatDate(p.date.slice(0, 10)) : ''}`}
               style={`--r: ${(p.w / p.h).toFixed(4)}`}>
              <img src={p.src} width={p.w} height={p.h} alt={`${g.title}, photo ${i + 1}`} loading="lazy" decoding="async" />
            </a>
          ))}
          <span class="filler" aria-hidden="true"></span>
        </div>
      </section>
    ))}
    {films.length > 0 && (
      <section class="set" id="films">
        <h2>Films</h2>
        <div class="films">{films.map((f) => <Film file={f} />)}</div>
      </section>
    )}
  </div>

  <nav class="pager container" aria-label="Albums voisins">
    {prev ? <a href={urls.album(prev.slug)}>← {prev.name}</a> : <span />}
    <a href={urls.rubrique(r.slug)}>Lire les récits : {r.name}</a>
    {next ? <a href={urls.album(next.slug)}>{next.name} →</a> : <span />}
  </nav>
</Base>

<script>
  import { initLightbox } from '../../scripts/lightbox';
  initLightbox();
</script>

<style>
  .head { padding: clamp(1.5rem, 4vw, 3rem) 0 1rem; }
  .toc { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .5rem; }
  .toc a { padding: .35rem .8rem; border-radius: 999px; background: var(--card); box-shadow: 0 0 0 1px var(--line); text-decoration: none; color: var(--ink); font-size: .9rem; }
  .toc a:hover { box-shadow: 0 0 0 1.5px var(--terracotta); color: var(--terracotta-ink); }
  .set { margin-bottom: 2.75rem; scroll-margin-top: 5rem; }
  .set h2 { font-size: 1.4rem; margin: 0 0 .8rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .9rem; }
  .set h2 small { font-family: var(--sans); font-size: .82rem; font-weight: 400; color: var(--ink-soft); }
  .more { font-family: var(--sans); font-size: .85rem; font-weight: 600; margin-left: auto; }
  /* grille « justifiée » : chaque photo garde ses proportions, les lignes ont la même hauteur */
  .justified { --h: clamp(8rem, 18vw, 13rem); display: flex; flex-wrap: wrap; gap: .4rem; }
  .justified .ph { flex: calc(var(--r) * 100) 1 calc(var(--r) * var(--h)); aspect-ratio: var(--r); border-radius: 4px; overflow: hidden; background: var(--sand-soft); cursor: zoom-in; }
  .justified img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .justified .ph:hover img { transform: scale(1.04); }
  .filler { flex: 1000 1 0; }
  .films { display: grid; gap: 0 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .films :global(.film) { width: 100%; margin: 0 0 1rem; }
  @media (max-width: 520px) { .justified { --h: 6.5rem; gap: .25rem; } }
  .pager { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: 1rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-weight: 600; }
  .pager a { text-decoration: none; }
</style>
