---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { rubriques, articlesOf, rubriquePeriod, itinerary, urls, type Rubrique } from '../../lib/data';

export function getStaticPaths() {
  return rubriques.map((r, i) => ({ params: { slug: r.slug }, props: { r, prev: rubriques[i - 1], next: rubriques[i + 1] } }));
}
interface Props { r: Rubrique; prev?: Rubrique; next?: Rubrique }
const { r, prev, next } = Astro.props;
const list = articlesOf(r.slug);
const period = rubriquePeriod(r.slug);
const slugs = new Set(list.map((a) => a.slug));
const places = [...new Set(itinerary.filter((s) => s.article && slugs.has(s.article)).map((s) => s.name))];
const desc = `${r.name} : ${list.length} récit${list.length > 1 ? 's' : ''} de notre tour du monde en famille${period ? ` (${period})` : ''}.`;
---
<Base title={r.name} description={desc} image={r.cover?.src}>
  <header class:list={['banner', { plain: !r.cover }]}>
    {r.cover && <img src={r.cover.src} width={r.cover.w} height={r.cover.h} alt="" />}
    <div class="container inner">
      <nav class="crumbs" aria-label="Fil d'Ariane"><ol><li><a href="/">Accueil</a></li><li aria-current="page">{r.name}</li></ol></nav>
      {r.continent && <p class="eyebrow">{r.continent}</p>}
      <h1>{r.name}</h1>
      <p class="sub">
        {period && <span>{period}</span>}
        <span>{list.length} récit{list.length > 1 ? 's' : ''}</span>
        {r.photoCount > 0 && <span>{r.photoCount} photos</span>}
      </p>
    </div>
  </header>

  <section class="container section">
    {places.length > 0 && (
      <p class="places"><strong>Étapes :</strong> {places.join(' · ')}</p>
    )}
    <div class="cards">
      {list.map((a) => <ArticleCard a={a} />)}
    </div>
    <div class="actions">
      {r.photoCount > 0 && r.continent && <a class="btn" href={urls.album(r.slug)}>Voir l'album photo</a>}
      <a class="btn ghost" href="/carte/">Situer sur la carte</a>
    </div>
  </section>

  <nav class="pager container" aria-label="Rubrique précédente et suivante">
    {prev ? <a href={urls.rubrique(prev.slug)}><small>← Étape précédente</small><span>{prev.name}</span></a> : <span />}
    {next ? <a class="next" href={urls.rubrique(next.slug)}><small>Étape suivante →</small><span>{next.name}</span></a> : <span />}
  </nav>
</Base>

<style>
  .banner { position: relative; min-height: clamp(16rem, 42vw, 26rem); display: flex; align-items: flex-end; color: #fff; background: var(--bordeaux); overflow: hidden; }
  .banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .banner::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgb(30 15 8 / .78), rgb(30 15 8 / .1) 60%); }
  .banner.plain { background: linear-gradient(135deg, var(--terracotta), var(--bordeaux)); min-height: 14rem; }
  .banner.plain::after { display: none; }
  .inner { position: relative; z-index: 1; padding-block: 2rem; }
  .banner h1 { color: #fff; margin: 0 0 .4rem; }
  .banner .eyebrow, .banner .crumbs, .banner .crumbs a { color: #fde3d3; }
  .sub { display: flex; flex-wrap: wrap; gap: .3rem 1.2rem; margin: 0; font-size: .95rem; opacity: .95; }
  .places { color: var(--ink-soft); margin: 0 0 1.75rem; max-width: 52rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .pager a { display: flex; flex-direction: column; padding: 1rem 1.2rem; border-radius: var(--radius); background: var(--card); box-shadow: 0 0 0 1px var(--line); text-decoration: none; }
  .pager a:hover { box-shadow: 0 0 0 2px var(--terracotta); }
  .pager small { color: var(--terracotta-ink); font-weight: 600; }
  .pager span { font-family: var(--serif); font-size: 1.15rem; color: var(--bordeaux); }
  .pager .next { text-align: right; }
</style>
